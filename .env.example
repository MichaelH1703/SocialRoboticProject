# Copy this file to .env and fill in your own values.
# Never upload your real .env file.

SUPABASE_URL=""
SUPABASE_KEY=""

THERAPIST_ID=""

CLIENT_NAME="Max"

# ==========================
# Deepgram Speech-to-Text (reachy_voice_V6.py only)
# ==========================

DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT=30

# ==========================
# Ollama
# ==========================

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=70
OLLAMA_TEMPERATURE=0.5
OLLAMA_TIMEOUT=90

# ==========================
# Reachy
# ==========================

AUDIO_MODE=reachy

REACHY_HOST=reachy-mini.local
REACHY_PORT=8000
REACHY_MEDIA_BACKEND=webrtc
REACHY_VOLUME=0.1

# ==========================
# Text-to-Speech
# ==========================

TTS_BACKEND=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL=path\to\piper_voices\en_GB-alan-medium.onnx

PLAYBACK_LEAD_MS=80
PLAYBACK_TAIL_MS=200
PLAYBACK_CHUNK_MS=40

# ==========================
# Voice Activity Detection
# ==========================

MAX_LISTEN_SECONDS=15
SPEECH_START_TIMEOUT=8

SILENCE_MS=550
VAD_AGGRESSIVENESS=2
MIN_SPEECH_MS=1800
MIC_WARMUP_MS=700
MIC_GAIN=0.7

# ==========================
# Streaming STT
# ==========================

STREAMING_STT=false
